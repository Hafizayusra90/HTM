@model IEnumerable<HTM.Models.Feedback>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Fbdate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Commentt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Guest)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Service)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Fbdate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Rating)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Commentt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Guest.Guestid)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Service.Serviceid)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Feedbackid">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Feedbackid">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Feedbackid">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
